# Unity Git Setup
/sdsim/[Ll]ibrary/
/sdsim/[Tt]emp/
/sdsim/[Oo]bj/
/sdsim/[Bb]uild/
/sdsim/[Bb]uilds/
/sdsim/.[Vv][Ss][Cc]ode/
/sdsim/.[Vv][Ss]/
/sdsim/Assets/AssetStoreTools*

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Generated if you use the new UIElements (either for editor or runtime in 2020)
/sdsim/[Uu][Ii][Ee]lements[Ss]chema/
# Upgrade and package manager logs for Unity etc. (and some asset logs in 2020 too now)
/sdsim/[Ll]ogs/
# Ignore UserSettings, we most likely don't want to sync these across users
/sdsim/[Uu]ser[Ss]ettings/

# Autogenerated VS/MD solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.unitypackage

# Mac stuff
.DS_Store
.bak
.BAK

# VS code
/sdsim/.vs
/sdsim/.vscode

# Other
*.pyc
*.h5
dataset
/camera_a.png
/camera_b.png
/sdsim/Builds
/src/camera_a.png
/src/camera_b.png
/sdsim/Assets/StreamingAssets
/sdsim/Assets/AssetBundles

# 本地构建产物
build/
dist/

# RL 产物:文档(journal/报告)入库,二进制模型/日志留本地
outputs/*.zip
outputs/rl_halloffame/
